{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Done",
  "version": "0.5.9",
  "identifier": "com.claudedone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Done · 环境助手",
        "width": 1220,
        "height": 860,
        "minWidth": 900,
        "minHeight": 660,
        "backgroundColor": "#F6F7F3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Claude 环境诊断与可撤销修复工具",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNzM2MDhFQUU1REI2QTIKUldTaXRsMnVqbUJ6SWtrUXVkenFUUllKaWZnZDdNL3ErV3BpZ1VudGNSYXlnbGFVVHpjSlRtc3oK",
      "endpoints": [
        "https://github.com/claudedone/claudedone/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
